APP_NAME=express-ts-template
PORT=3020
NODE_ENV=development

# Only required after wiring database initialization in index.ts.
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB_NAME=express-ts-template

# Redis cache and BullMQ are opt-in. Queue and cache can use separate Redis URLs.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=express-ts-template:
QUEUE_ENABLED=false
QUEUE_WORKER_ENABLED=false
QUEUE_REDIS_URL=redis://127.0.0.1:6379/1
QUEUE_CONCURRENCY=5

# Set this before using /api/v1/examples/private.
TOKEN_SECRET=replace-with-a-long-random-secret
