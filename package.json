{
    "name": "express-ts-template",
    "version": "1.0.0",
    "private": true,
    "description": "A lightweight standalone Express TypeScript service template",
    "main": "index.ts",
    "scripts": {
        "dev": "tsx ./index.ts",
        "start": "tsx ./index.ts",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "lint": "eslint . --ext .ts,.mts"
    },
    "dependencies": {
        "@typegoose/typegoose": "12.5.0",
        "bullmq": "^6.3.8",
        "cors": "2.8.5",
        "express": "4.21.2",
        "ioredis": "5.4.1",
        "jsonwebtoken": "8.5.1",
        "mongoose": "8.4.4",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/cors": "2.8.17",
        "@types/express": "4.17.21",
        "@types/jsonwebtoken": "9.0.9",
        "@types/node": "20.17.9",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "7.18.0",
        "@typescript-eslint/parser": "7.18.0",
        "eslint": "8.57.1",
        "supertest": "7.2.2",
        "tsx": "^4.19.3",
        "typescript": "6.0.2",
        "vitest": "4.1.5"
    }
}
